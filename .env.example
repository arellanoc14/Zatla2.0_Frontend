# Both are baked into the bundle at build time: set them on the Render static
# site before it builds. Local dev needs neither (the API defaults to
# http://localhost:3001).
# The backend's address, no trailing slash: https://zatla2-backend.onrender.com
VITE_API_URL=
# Stripe publishable key (pk_test_/pk_live_), same account and mode as the
# backend's STRIPE_SECRET_KEY. Without it /checkout shows "not set up yet".
VITE_STRIPE_PUBLISHABLE_KEY=
