# Both are baked into the bundle at build time: set them on the Render static
# site before it builds. Local dev can leave both unset (the API then defaults
# to http://localhost:3001).
# The API's address, no trailing slash. Checkout, order status and shared
# designs all call it: https://zatla-web.onrender.com
VITE_API_URL=https://zatla-web.onrender.com
# Stripe publishable key (pk_test_/pk_live_), same account and mode as the
# API's STRIPE_SECRET_KEY. Without it /checkout shows "not set up yet".
VITE_STRIPE_PUBLISHABLE_KEY=
